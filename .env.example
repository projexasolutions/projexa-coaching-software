# Institute owner signup email verification (required to enable public signup)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@your-domain.com
SIGNUP_VERIFICATION_URL=http://localhost:5173/verify-institute
SIGNUP_VERIFICATION_MINUTES=30

# Teacher / student / parent account invitations
INVITATION_ACCEPT_URL=http://localhost:5173/accept-invitation
INVITATION_EXPIRY_MINUTES=4320

# Password reset link destination
PASSWORD_RESET_URL=http://localhost:5173/reset-password
